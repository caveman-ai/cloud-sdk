{
  "name": "@caveman-ai/sdk",
  "version": "2.0.0",
  "description": "Zero-dependency TypeScript SDK for Caveman Cloud: Inference, Managed Agents, Sessions, Sandboxes, Drives, Connectors, Secrets, Rooms, Apps, and Evals.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./app-bridge": {
      "types": "./dist/app-bridge.d.ts",
      "default": "./dist/app-bridge.js"
    },
    "./evals": {
      "types": "./dist/evals.d.ts",
      "default": "./dist/evals.js"
    },
    "./cloud": {
      "types": "./dist/cloud.d.ts",
      "default": "./dist/cloud.js"
    },
    "./agents": {
      "types": "./dist/agents.d.ts",
      "default": "./dist/agents.js"
    },
    "./sandboxes": {
      "types": "./dist/sandboxes.d.ts",
      "default": "./dist/sandboxes.js"
    },
    "./rooms": {
      "types": "./dist/rooms.d.ts",
      "default": "./dist/rooms.js"
    },
    "./apps": {
      "types": "./dist/apps.d.ts",
      "default": "./dist/apps.js"
    },
    "./listeners": {
      "types": "./dist/listeners.d.ts",
      "default": "./dist/listeners.js"
    },
    "./workflows": {
      "types": "./dist/workflows.d.ts",
      "default": "./dist/workflows.js"
    },
    "./pools": {
      "types": "./dist/pools.d.ts",
      "default": "./dist/pools.js"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "default": "./dist/router.js"
    },
    "./gate": {
      "types": "./dist/gate.d.ts",
      "default": "./dist/gate.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caveman-ai/cloud-sdk.git",
    "directory": "packages/sdk-ts"
  },
  "homepage": "https://docs.caveman.so/sdk/typescript",
  "bugs": {
    "url": "https://github.com/caveman-ai/cloud-sdk/issues"
  },
  "keywords": [
    "agents",
    "ai",
    "llm",
    "observability",
    "opentelemetry",
    "optimization"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "lint": "tsc --noEmit",
    "test": "npm run build && npm run test:types && npm run test:node",
    "test:types": "tsc --project tsconfig.test.json",
    "test:node": "node --test tests/*.runtime.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
